# ═══════════════════════════════════════════════════════════
#  Triage Agent Environment Configuration (.env.example)
# ═══════════════════════════════════════════════════════════

TRIAGE_AGENT_PORT=4015
TRIAGE_AGENT_HOST="127.0.0.1"

# Cognitive Ingress (Tier 1 Swarm Gateway)
SWARM_GATEWAY_URL="http://127.0.0.1:8080"
SWARM_GATEWAY_TOKEN=""
SWARM_MODEL_ID="openai/gpt-oss-20b"
SWARM_COGNITIVE_FORMAT="responses"

# Commercial B2B Agent (Domain Worker Dependency)
COMMERCIAL_B2B_AGENT_URL="http://127.0.0.1:4010"
COMMERCIAL_B2B_AGENT_DID="did:web:agents.enterprise.internal:commercial-b2b"

# Marketplace Trust Gateway (Tier 2 Execution Egress)
TRUST_GATEWAY_URL="http://127.0.0.1:8081"
TRUST_GATEWAY_API_KEY=""

# Triage & Evaluation Settings
MAX_AUTO_APPROVE_BLAST_RADIUS="Low"
CONFIDENCE_THRESHOLD_PERCENT=85
